{
  "name": "@polyspec/http-cookie",
  "version": "0.0.0",
  "description": "The http-cookie library of polyspec for Node and the browser",
  "license": "MIT",
  "main": "./generated/index.cjs",
  "types": "./generated/index.d.ts",
  "exports": {
    ".": {
      "browser": {
        "types": "./wasm/generated/index.d.ts",
        "default": "./wasm/generated/index.mjs"
      },
      "types": "./generated/index.d.ts",
      "import": "./generated/index.mjs",
      "require": "./generated/index.cjs"
    },
    "./wasm": {
      "types": "./wasm/generated/index.d.ts",
      "default": "./wasm/generated/index.mjs"
    }
  },
  "files": [
    "generated/index.cjs",
    "generated/index.mjs",
    "generated/index.d.ts",
    "wasm/generated/*.mjs",
    "wasm/generated/*.js",
    "wasm/generated/*.d.ts",
    "wasm/generated/*.wasm"
  ],
  "optionalDependencies": {
    "@polyspec/http-cookie-linux-x64-gnu": "0.0.0",
    "@polyspec/http-cookie-linux-arm64-gnu": "0.0.0",
    "@polyspec/http-cookie-darwin-arm64": "0.0.0"
  }
}
